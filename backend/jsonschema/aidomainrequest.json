{
  "$extends": [
    "@sharded",
    "@identifiable",
    "@timed"
  ],
  "$friendlyName": "AI Domain Request",
  "$friendlyNamePlural": "AI Domain Requests",
  "$modelName": "AIDomainRequest",
  "$modelPackage": "zukan",
  "$modelResourceName": "aidomainrequests",
  "$modelRestName": "aidomainrequest",
  "additionalProperties": false,
  "description": "A request for a risk report on a domain the AI domain catalog does not have. A namespace holds one request per domain.",
