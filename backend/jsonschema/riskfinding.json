{
  "$extends": [
    "@sharded",
    "@identifiable",
    "@importable",
    "@namelinkable"
  ],
  "$friendlyName": "Risk Finding",
  "$friendlyNamePlural": "Risk Findings",
  "$modelName": "RiskFinding",
  "$modelPackage": "hanni",
  "$modelResourceName": "riskfindings",
  "$modelRestName": "riskfinding",
  "additionalProperties": false,
  "description": "Defines a risk finding instantiated from a risk definition that matched a discovered AI asset.",
  "properties": {
    "ID": {
      "$friendlyName": "ID",
      "$readOnly": true,
      "description": "ID is the identifier of the object.",
      "title": "ID",
      "type": [
        "string",
        "null"
      ]
    },
    "analyzerGroup": {
      "$friendlyName": "Analyzer Group",
      "description": "The analyzer group.",
      "title": "analyzerGroup",
      "type": [
        "string",
        "null"
      ]
    },
    "analyzerName": {
      "$friendlyName": "Analyzer Name",
      "description": "The analyzer name.",
      "title": "analyzerName",
      "type": [
        "string",
        "null"
      ]
    },
    "assetRef": {
      "$friendlyName": "Asset Reference",
      "$ref": "assetref.json",
      "description": "Reference to the asset this finding applies to.",
      "title": "assetRef"
    },
    "description": {
      "$friendlyName": "Description",
      "description": "The description of the finding.",
      "title": "description",
      "type": [
        "string",
        "null"
      ]
    },
    "firstSeenTime": {
      "$friendlyName": "First Seen Time",
      "description": "First time the finding was seen.",
      "title": "firstSeenTime",
      "type": [
        "string",
        "null"
      ]
    },
    "friendlyName": {
      "$friendlyName": "Friendly Name",
      "$required": true,
      "description": "Friendly name of the object.",
      "title": "friendlyName",
      "type": "string"
    },
    "importHash": {
      "$creationOnly": true,
      "$friendlyName": "ImportHash",
      "description": "The hash of the structure used to compare with new import version.",
      "title": "importHash",
      "type": [
        "string",
        "null"
      ]
    },
    "importLabel": {
      "$creationOnly": true,
      "$friendlyName": "ImportLabel",
      "description": "The user-defined import label that allows the system to group resources from the same import operation.",
      "title": "importLabel",
      "type": [
        "string",
        "null"
      ]
    },
    "lastResolutionComment": {
      "$friendlyName": "Last Resolution Comment",
      "description": "Comment about the last resolution.",
      "title": "lastResolutionComment",
      "type": [
        "string",
        "null"
      ]
    },
    "lastSeenTime": {
      "$friendlyName": "Last Seen Time",
      "description": "Last time the finding was seen.",
      "title": "lastSeenTime",
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "$creationOnly": true,
      "$friendlyName": "Name",
      "description": "The internal reference name of the object. It is a sanitized version of Friendly Name if empty.",
      "pattern": "(^[a-zA-Z0-9-_]+$)?",
      "title": "name",
      "type": [
        "string",
        "null"
      ]
    },
    "namespace": {
      "$friendlyName": "Namespace",
      "$readOnly": true,
      "description": "The namespace of the object.",
      "title": "namespace",
      "type": [
        "string",
        "null"
      ]
    },
    "resolutionIdentities": {
      "$friendlyName": "Identities",
      "description": "The identities that can resolve this finding.",
      "items": {
        "type": [
          "string",
          "null"
        ]
      },
      "title": "resolutionIdentities",
      "type": "array"
    },
    "severity": {
      "$friendlyName": "Severity",
      "$required": true,
      "description": "The severity of the finding.",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Critical"
      ],
      "title": "severity"
    },
    "severityOverride": {
      "$friendlyName": "Severity Override",
      "$ref": "severityoverride.json",
      "description": "User override of the system generated severity. When set, the severity attribute reflects the override.",
      "title": "severityOverride"
    },
    "state": {
      "$friendlyName": "State",
      "description": "The state of the finding.",
      "title": "state",
      "type": "object"
    },
    "status": {
      "$friendlyName": "Status",
      "$required": true,
      "description": "The status of the finding.",
      "enum": [
        "Open",
        "Resolved",
        "Rejected",
        "Archived"
      ],
      "title": "status"
    },
    "systemGeneratedSeverity": {
      "$friendlyName": "System Generated Severity",
      "description": "The severity computed by the system when the finding was created. Not affected by user overrides.",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Critical"
      ],
      "title": "systemGeneratedSeverity"
    }
  },
  "required": [
    "friendlyName",
    "severity",
    "status"
  ],
  "title": "RiskFinding",
  "type": "object"
}