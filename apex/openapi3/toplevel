              "ToolDefinition",
              "ToolInput",
              "ToolOutput",
              "File",
              "Resource",
              "Event"
            ]
          },
          "role": {
            "default": "User",
            "description": "The role of the message represented by this extraction.",
            "enum": [
              "User",
              "Assistant",
              "System",
              "Tool"
