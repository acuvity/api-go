            "example": "k8s:namespace=demo",
            "type": "string"
          }
        },
        "type": "object"
      },
      "principaluser": {
        "description": "Describes the principal information of a user.",
        "properties": {
          "name": {
            "description": "Identification bit that will be used to identify the origin of the request.",
            "example": "user@company.com",
            "type": "string"
          },
          "untrusted": {
            "description": "If true, the data is not fully trusted (eg. loose identity).",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "requestdestination": {
        "description": "RequestDestination holds the destination information for a request. When app\nand component are set, the request is evaluated against the app component's\npolicies instead of a provider. In that case, the provider field must not be\nset.\nOn the police API an egress request must name its target, so app and component\nare required unless a provider is given. On the scan API they may be left out\nto run a plain scan that targets nothing.",
        "properties": {
          "app": {
            "description": "The name of the destination application. Only takes effect together with\ncomponent: setting one without the other counts as no destination at all.",
            "example": "other-ai-app",
            "type": "string"
          },
          "component": {
            "description": "The component of the destination application. Only takes effect together with\napp: setting one without the other counts as no destination at all.",
            "example": "backend",
            "type": "string"
          },
          "host": {
            "description": "The host name of the destination. Optional, for logging enrichment.",
            "example": "api.openai.com",
            "type": "string"
          },
          "ip": {
            "description": "The destination IP address. Optional, for logging enrichment.",
            "example": "192.0.2.42",
            "type": "string"
          },
          "port": {
            "description": "The destination port of the request. Optional: when it is not set, 443 is\nassumed. It is made available to policies as destinationPort.",
            "example": 443,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "requestsource": {
        "description": "RequestSource holds the information about where a request originates from. On\negress, the source is the app component the caller's token identifies, and this\nonly carries optional enrichment. On ingress, the source is whoever is calling\ninto that app component, and the token field identifies it.\nThe username and userClaims are only used when no token is given, or when the\ngiven token carries no user identity of its own: identity derived from a\nvalidated token always wins over identity asserted in the request body.",
        "properties": {
          "ip": {
            "description": "The source IP address of the request. Optional, for logging enrichment.",
            "example": "192.0.2.42",
            "type": "string"
          },
          "token": {
            "description": "A valid token identifying the source of the request. Only applicable when the\ndirection is Ingress. This can either be a component token, in which case the\nrequest principal is populated with the source app and component identity, or\na token issued for an application component OAuth client, in which case the\nsource app and component as well as the user identity are both derived from\nit.",
            "type": "string"
          },
          "userClaims": {
            "description": "The optional user claims of the request. This can be an incomplete list, and\nclaims can be mapped to different keys.",
            "example": [
              "name=John Doe",
              "email=john.doe@acme.com",
              "@validated=false"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "username": {
            "description": "The optional username of the request.",
            "example": "john.doe@acme.com",
            "type": "string"
          }
        },
        "type": "object"
      },
      "requesttrace": {
        "description": "RequestTrace is the trace context a caller hands to the Apex APIs so that this\nrequest is placed inside the caller's own trace. It is deliberately narrower\nthan\nthe trace reference reported back on the response: the caller only says which\ntrace this request belongs to and which span to hang it under. Everything else\nabout the span, meaning its ID, name, kind, start, end and status, describes\nwhat\nApex actually did, so Apex generates it.",
        "properties": {
          "parentSpanID": {
            "description": "The span ID, as a hex encoded string, that the span Apex creates for this\nrequest must be a child of. Leave it out when you have a trace but no span to\nattach this request to, in which case the span Apex creates becomes a root span\nof that trace.",
            "example": "00f067aa0ba902b7",
            "type": "string"
          },
          "traceID": {
            "description": "The trace ID, as a hex encoded string, this request belongs to.",
            "example": "4bf92f3577b34da6a3ce929d0e0e4736",
            "type": "string"
          }
        },
        "required": [
          "traceID"
        ],
        "type": "object"
      },
      "roundtriperror": {
        "description": "Structured error info attached to a roundtrip when a non-user-facing\nplatform stage or the upstream provider failed. Carries the platform-side\ndetail (type, stage, message) for debugging and provider-health\nderivation. The Decision field still reflects the policy/processing\noutcome per existing semantics.",
        "properties": {
          "message": {
            "description": "Human-readable error message.",
            "type": "string"
          },
          "previousDecision": {
            "description": "The decision produced before the failClose or failOpen mutation\nflipped it. Set only when the user-facing Decision is the result\nof a platform-error override, so the audit log can surface what\nthe policy would have decided otherwise.",
            "enum": [
              "Deny",
              "Allow",
              "Ask",
              "Report",
              "Bypassed",
              "ForbiddenUser",
              "Skipped",
              "Redirected",
              "NotApplicable"
            ],
            "readOnly": true
          },
          "stage": {
            "description": "The pipeline component that produced the error. Combined with the\nType axis on the parent round-trip (Input/Output) and the Offband\nflag, gives the full discrimination of where a platform/upstream\nfailure originated. Each value maps to an ownership tier:\nProofpoint AI Security-owned (Extraction, Analysis, AssignPolicy, AccessPolicy,\nRedaction),\ncustomer-owned (ContentPolicy), provider-owned (Upstream).",
            "enum": [
              "Extraction",
              "Analysis",
              "ContentPolicy",
              "AssignPolicy",
              "AccessPolicy",
              "Upstream",
              "Redaction"
            ]
          },
          "type": {
            "description": "The source of the failure. PlatformError covers apex-side stages\n(Extraction, Analysis, ContentPolicy, AccessPolicy). UpstreamError\ncovers anything attributable to the upstream provider (transport\nfailures or non-2xx HTTP responses).",
            "enum": [
              "PlatformError",
              "UpstreamError"
            ]
          }
        },
        "type": "object"
      },
      "scanrequest": {
        "description": "This is a scan request. Scan enforces no policy, so unlike police it can be used\nas a plain analyzer with no destination in mind: provider, destination and\ndirection may all be left out.",
        "properties": {
          "analyzers": {
            "description": "The analyzers parameter allows for customizing which analyzers should be used,\noverriding the default selection. Each analyzer entry can optionally include a\nprefix to modify its behavior:\n\n  - No prefix: Runs only the specified analyzers and any dependencies required\nfor deeper analysis (slower but more acurate).\n  - '+' (enable): Activates an analyzer that is disabled by default.\n  - '-' (disable): Disables an analyzer that is enabled by default.\n  - '@' (direct execution): Runs the analyzer immediately, bypassing the deeper\nanalysis (faster but less acurate).\n\nAn analyzers entry can be specified using:\n  - The analyzer name (e.g., 'Toxicity detector')\n  - The analyzer ID (e.g., 'en-text-toxicity-detector')\n  - The analyzer group (e.g., 'Detectors')\n  - A detector name (e.g., 'toxic')\n  - A detector label (e.g., 'insult')\n  - A detector group (e.g., 'Malcontents')\n\nIf left empty, all default analyzers will be executed.",
            "example": [
              "Malcontents"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "anonymization": {
            "default": "FixedSize",
            "description": "How to anonymize the data. If deanonymize is true, then VariablSize is required.",
            "enum": [
              "FixedSize",
              "VariableSize"
            ]
          },
          "conversationID": {
            "description": "Identifies the conversation this request belongs to. Apex records it on the\nresulting log, which is what groups the successive requests of one conversation\ntogether in the logs and in the conversation view, and it is also made available\nto the analyzers and to policies. Send the same value on every request of the\nsame conversation.",
            "example": "6f37d752-bce1-4973-88f6-28b6c100ceb8",
            "type": "string"
          },
          "destination": {
            "$ref": "#/components/schemas/requestdestination"
          },
          "direction": {
            "default": "Egress",
            "description": "The direction of the traffic for this request, relative to the app component\nthe caller's token identifies. Determines whether the ingress or the egress\npolicies of that app component are evaluated.",
            "enum": [
              "Egress",
              "Ingress"
            ]
          },
          "extractions": {
            "description": "The extractions to request.",
            "items": {
              "$ref": "#/components/schemas/extractionrequest"
            },
            "type": "array"
          },
          "keywords": {
            "description": "The keywords found during classification.",
            "example": [
              "legal",
              "technical",
              "scientific"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "messages": {
            "description": "Messages to process and provide detections for. Use data in extractions for\nprocessing binary data.",
            "example": [
              "Summarize the main points of this article in bullet points.",
              "Generate a list of creative product names for a futuristic tech gadget."
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "provider": {
            "description": "The name of the provider to use for policy resolutions. Must not be set when\ndestination app and component are set.\nOn the police API an egress request must set either this or the destination app\nand component. On the scan API both may be omitted to run a plain scan that\ntargets nothing.",
            "example": "openai",
            "type": "string"
          },
          "redactContent": {
            "description": "If true, the user data is removed from the logged roundtrip, while the\nanalysis and all other metadata are kept. This only affects what is logged:\nthe response of this call always carries the full content.",
            "type": "boolean"
          },
          "redactContentBypass": {
            "description": "If true, and redactContent is also true, the user data is kept in the\nlogged roundtrip whenever the decision reports a violation, so that the\ncontent behind a denial stays available for review. It has no effect on\nits own.",
            "type": "boolean"
          },
          "redactions": {
            "description": "The redactions to perform if they are detected.",
            "example": [
              "person",
              "ssn",
              "location"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "source": {
            "$ref": "#/components/schemas/requestsource"
          },
          "tools": {
            "additionalProperties": {
              "$ref": "#/components/schemas/tool"
            },
            "description": "The various tools used by the request.",
            "example": "{\n  \"tool1\": {\n      \"name\": \"tool1\",\n      \"description\": \"This is a tool.\"\n  }\n}",
            "type": "object"
          },
          "trace": {
            "$ref": "#/components/schemas/requesttrace"
          },
          "type": {
            "description": "The type of text.",
            "enum": [
              "Input",
              "Output"
            ]
          }
        },
        "type": "object"
      },
      "scanresponse": {
        "description": "This is a scan response.",
        "properties": {
          "ID": {
            "description": "ID is the identifier of the object.",
            "readOnly": true,
            "type": "string"
          },
          "alerts": {
            "description": "List of alerts that got raised during the policy resolution.",
            "items": {
              "$ref": "#/components/schemas/alertevent"
            },
            "type": "array"
          },
          "annotations": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Annotations attached to the log.",
            "type": "object"
          },
          "client": {
            "description": "The client used to send the request.",
            "example": "curl",
            "type": "string"
          },
          "clientVersion": {
            "description": "The version of the client used to send the request.",
            "example": "7.64.1",
            "type": "string"
          },
          "contentRedacted": {
            "description": "If true, the content of the extractions was stripped from the audit entry for\nthis request, and only the analysis and other metadata were kept. It reports\nwhat actually happened, which is not the same as what was requested:\nredactContentBypass can leave the content in place.",
            "type": "boolean"
          },
          "decision": {
            "description": "User-facing outcome of the roundtrip. Reflects the policy\nengine's verdict, or in case of platform failure, the result of the\nfailClose strategy (Deny on fail-close, Allow on fail-open, with\nstructured error field carring the detail). NotApplicable is\nused by the scan and police APIs, which analyze content without\nrendering an enforcement decision. Error and UpstreamError stay\nin the allowed_choices list for backward compatibility with\nclients that still PUT those values; new round-trips never emit\nthem — platform/upstream failures now surface via the structured\nError field instead.\nNOTE: safe to drop Error and UpstreamError from this enum on or\nafter 2026-07-19 (two months after the structured RoundtripError\nlanded on 2026-05-19), once consumers have rolled forward.",
            "enum": [
              "Deny",
              "Allow",
              "Ask",
              "Report",
              "Bypassed",
              "ForbiddenUser",
              "Skipped",
              "Redirected",
              "NotApplicable",
              "Error",
              "UpstreamError"
            ]
          },
          "destination": {
            "$ref": "#/components/schemas/destination"
          },
          "error": {
            "$ref": "#/components/schemas/roundtriperror"
          },
          "extractions": {
            "description": "The extractions to log.",
            "items": {
              "$ref": "#/components/schemas/extraction"
            },
            "type": "array"
          },
          "hash": {
            "description": "The hash of the input.",
            "type": "string"
          },
          "latency": {
            "$ref": "#/components/schemas/latency"
          },
          "mcpMessage": {
            "$ref": "#/components/schemas/mcpmessage"
          },
          "model": {
            "description": "The model used by the request.",
            "example": "claude-3-7-sonnet",
            "type": "string"
          },
          "namespace": {
            "description": "The namespace of the object.",
            "readOnly": true,
            "type": "string"
          },
          "pipelineName": {
            "description": "The name of the particular pipeline that extracted the text.",
            "type": "string"
          },
          "principal": {
            "$ref": "#/components/schemas/principal"
          },
          "provider": {
            "description": "The provider to use.",
            "example": "openai",
            "type": "string"
          },
          "providerType": {
            "description": "The type of the provider.",
            "enum": [
              "LLM",
              "MCPServer"
            ],
            "example": "LLM"
          },
          "reasons": {
            "description": "The various reasons returned by the policy engine.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "summary": {
            "$ref": "#/components/schemas/extractionsummary"
          },
          "time": {
            "description": "Set the time of the message request.",
            "format": "date-time",
            "type": "string"
          },
          "toolChoice": {
            "$ref": "#/components/schemas/toolchoice"
          },
          "tools": {
            "additionalProperties": {
              "$ref": "#/components/schemas/tool"
            },
            "description": "The various tools used by the request.",
            "example": "{\n  \"tool1\": {\n      \"name\": \"tool1\",\n      \"description\": \"This is a tool.\"\n  }\n}",
            "type": "object"
          },
          "trace": {
            "$ref": "#/components/schemas/traceref"
          },
          "type": {
            "description": "The type of text.",
            "enum": [
              "Input",
              "Output"
            ]
          }
        },
        "required": [
          "principal",
          "providerType"
        ],
        "type": "object"
      },
      "textualdetection": {
        "description": "Represents a textual detection done by policy.",
        "properties": {
          "end": {
            "description": "The end position of the detection in the original data.",
            "type": "integer"
          },
          "key": {
            "description": "The key that is used in the name's place, If empty, a sequence of X's are used.",
            "type": "string"
          },
          "name": {
            "description": "The name of the detection.",
            "type": "string"
          },
          "redacted": {
            "description": "If true this detection has been redacted.",
            "type": "boolean"
          },
          "redactedEnd": {
            "description": "The end position of the detection in the redacted data.",
            "type": "integer"
          },
          "redactedStart": {
            "description": "The start position of the detection in the redacted data.",
            "type": "integer"
          },
          "score": {
            "description": "The confidence score of the detection.",
            "type": "number"
          },
          "start": {
            "description": "The start position of the detection in the original data.",
            "type": "integer"
          },
          "type": {
            "description": "The type of detection.",
            "enum": [
              "Keyword",
              "PII",
              "Secret",
              "CDT"
            ]
          }
        },
        "type": "object"
      },
      "tool": {
        "description": "Represents a tool that can enhance a genAI model's capabilities.",
        "properties": {
          "MCPAnnotations": {
            "$ref": "#/components/schemas/mcptoolannotations"
          },
          "MCPServer": {
            "$ref": "#/components/schemas/mcpserver"
          },
          "arguments": {
            "description": "The input arguments accepted by this tool.",
            "items": {
              "$ref": "#/components/schemas/toolargument"
            },
            "type": "array"
          },
          "category": {
            "description": "The category of the tool. This relays information about where the tool is being\nused. This can be empty if unknown or if this is a tool listing of MCP servers.",
            "enum": [
              "Client",
              "Server",
              "RemoteMCP"
            ],
            "example": "Client"
          },
          "description": {
            "description": "The description of the tool.",
            "example": "Get the current weather in a given location",
            "type": "string"
          },
          "name": {
            "description": "The name of the tool.",
            "example": "get_weather",
            "type": "string"
          },
          "type": {
            "description": "The type of the tool as can be optionally passed by the provider.",
            "example": "computer_20250124",
            "type": "string"
          }
        },
        "type": "object"
      },
      "toolargument": {
        "description": "Represents a tool input argument.",
        "properties": {
          "description": {
            "description": "The description of the argument.",
            "example": "URL to fetch.",
            "type": "string"
          },
          "name": {
            "description": "The name of the argument.",
            "example": "url",
            "type": "string"
          },
          "required": {
            "description": "Whether this argument is required by the tool.",
            "type": "boolean"
          },
          "schema": {
            "additionalProperties": true,
            "description": "The JSON schema for this argument, excluding fields promoted to top-level\nattributes.",
            "type": "object"
          },
          "type": {
            "description": "The JSON schema type of the argument.",
            "example": "string",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "toolchoice": {
        "description": "Represents the tool choice that can be passed along together with tools.",
        "properties": {
          "choice": {
            "default": "Auto",
            "description": "Model instructions on tool choice.",
            "enum": [
              "Auto",
              "Any",
              "None",
              "Tool"
            ]
          },
          "name": {
            "description": "If choice is Tool, this will be set to the name of the tool to use.",
            "type": "string"
          }
        },
        "required": [
          "choice"
        ],
        "type": "object"
      },
      "toolresult": {
        "description": "Represents the tool result as passed in by the user or application after calling\na tool.",
        "properties": {
          "callID": {
            "description": "The ID of the tool use as previously returned by a tool use response.",
            "example": "toolu_019X5QaEeVTDFrQPHqMMgd1n",
            "type": "string"
          },
          "content": {
            "description": "The content of the tool call results.",
            "type": "string"
          },
          "isError": {
            "default": false,
            "description": "Indicates if the tool call failed.",
            "type": "boolean"
          },
          "name": {
            "description": "The name of the tool used.",
            "example": "fetch",
            "type": "string"
          },
          "serverName": {
            "description": "The server name of the tool used.",
            "example": "my-mcp-server",
            "type": "string"
          }
        },
        "required": [
          "callID"
        ],
        "type": "object"
      },
      "tooluse": {
        "description": "Represents the tool use which are instructions by a model on what tool to call\nand how.",
        "properties": {
          "callID": {
            "description": "The ID of the tool use which the user or application must pass when posting back\nthe tool call results.",
            "example": "toolu_019X5QaEeVTDFrQPHqMMgd1n",
            "type": "string"
          },
          "input": {
            "description": "The input to the tool call. This should be a JSON object which must conform to\nthe JSON schema as was previously defined for the tool.",
            "type": "string"
          },
          "name": {
            "description": "The name of the tool to call.",
            "example": "get_weather",
            "type": "string"
          },
          "serverName": {
            "description": "The name of the remote MCP server that will execute this call.",
            "example": "deepwiki",
            "type": "string"
          }
        },
        "required": [
          "callID",
          "name"
        ],
        "type": "object"
      },
      "traceref": {
        "description": "Holds all references to a trace which are also the essentials of the span data.",
        "properties": {
          "kind": {
            "default": "Unspecified",
            "description": "The kind of the span.",
            "enum": [
              "Unspecified",
              "Internal",
              "Server",
              "Client",
              "Producer",
              "Consumer"
            ],
            "example": "Server"
          },
          "parentSpanID": {
            "description": "The parent span ID that is being referenced as hex encoded string.",
            "example": "00f067aa0ba902b7",
            "type": "string"
          },
          "spanEnd": {
            "description": "When the span ended.",
            "example": "2025-03-22T14:35:00.123456789Z",
            "format": "date-time",
            "type": "string"
          },
          "spanID": {
            "description": "The span ID that is being referenced.",
            "example": "6ba80aaa3b2f43d8",
            "type": "string"
          },
          "spanName": {
            "description": "The name of the span that is being collected.",
            "example": "acuvity_prompt_input_analysis",
            "type": "string"
          },
          "spanStart": {
            "description": "When the span started.",
            "example": "2025-03-22T14:35:00.123456789Z",
            "format": "date-time",
            "type": "string"
          },
          "statusCode": {
            "default": "Unset",
            "description": "Status Code of a span.",
            "enum": [
              "Unset",
              "OK",
              "Error"
            ],
            "example": "OK"
          },
          "statusMessage": {
            "description": "A developer-facing human readable error message.",
            "example": "Failed to make API call to service Foo.",
            "type": "string"
          },
          "traceID": {
            "description": "The Trace ID that is being referenced as hex encoded string.",
            "example": "4bf92f3577b34da6a3ce929d0e0e4736",
            "type": "string"
          },
          "transparentSpanID": {
            "description": "The transparent span ID that is being referenced. If the application operates in\ntransparent tracing mode, then this field must be set to the span ID that this\nspan is originally referencing.",
            "example": "6ba80aaa3b2f43d8",
            "type": "string"
          }
        },
        "required": [
          "spanEnd",
          "spanID",
          "spanName",
          "spanStart",
          "traceID"
        ],
        "type": "object"
      }
    },
